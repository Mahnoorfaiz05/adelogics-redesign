# Copy to .env.local for local development, or configure these in
# Vercel → Project → Settings → Environment Variables. Never commit real secrets.

# Public site URL used for canonical links, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://www.adelogix.com

# Optional Postgres backup for contact-form records. EmailJS still works without it.
DATABASE_URL=

# Optional: Google Analytics 4 measurement ID. When empty, analytics stay disabled.
NEXT_PUBLIC_GA4_ID=

# EmailJS browser SDK configuration (required to activate the contact form).
# Create an EmailJS email service that sends to Adelogixteam@gmail.com, then make
# a template using: to_email, from_name, from_email, reply_to, subject, message,
# company, service, budget, preferred_contact_method, phone, submitted_at.
# EmailJS public keys are intentionally browser-visible; do NOT add private email
# credentials to the website or these NEXT_PUBLIC_ values.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# WhatsApp Business Cloud API (server-only; leave empty until Meta setup is done).
# Use a long random value for WHATSAPP_API_INTERNAL_SECRET. Never prefix these
# variables with NEXT_PUBLIC_ and never enter access tokens in frontend code.
WHATSAPP_CLOUD_API_ACCESS_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_API_VERSION=v23.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_INTERNAL_SECRET=
