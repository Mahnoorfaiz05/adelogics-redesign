# Copy to .env.local (or set in Vercel → Project → Settings → Environment Variables).
# Never commit real secrets.

# Public site URL used for canonical links, sitemap and Open Graph tags
NEXT_PUBLIC_SITE_URL=https://www.adelogix.com

# Local Postgres (the platform provides DATABASE_URL in its own environment)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional: Google Analytics 4 measurement ID. When empty, the cookie banner stays hidden.
NEXT_PUBLIC_GA4_ID=

# Optional: verified official social profiles. Empty values render as inactive footer
# icons. Paste a full URL to activate the matching icon — no code changes needed.
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
